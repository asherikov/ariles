set (@PROJECT_NAME@_VERSION @PROJECT_VERSION_MAJOR@.@PROJECT_VERSION_MINOR@.@PROJECT_VERSION_PATCH@)

@PACKAGE_INIT@

@ARILES_FIND_CORE@

include("${CMAKE_CURRENT_LIST_DIR}/@ARILES_COMPONENT@_targets.cmake")

include(CMakeFindDependencyMacro)
foreach(DEP @ARILES_COMPONENT_CMAKE_DEPS@)
    find_dependency(${DEP})
endforeach()

